      "parameters": {
        "fromEmail": "your-email@gmail.com",
        "toEmail": "your-email@gmail.com",
        "subject": "=トレードジャーナル - 統計レポート ({{ $json.reportDate.split('T')[0] }})",
        "emailType": "html",
        "message": "=<h2>📊 トレード統計レポート</h2>\n\n<h3>全体統計</h3>\n<ul>\n  <li><strong>総トレード数:</strong> {{ $json.totalTrades }}</li>\n  <li><strong>勝ちトレード:</strong> {{ $json.wins }}</li>\n  <li><strong>負けトレード:</strong> {{ $json.losses }}</li>\n  <li><strong>勝率:</strong> {{ $json.winRate }}%</li>\n  <li><strong>総損益:</strong> {{ $json.totalProfit }}</li>\n</ul>\n\n<h3>パフォーマンス指標</h3>\n<ul>\n  <li><strong>平均勝ちトレード:</strong> {{ $json.avgWin }}</li>\n  <li><strong>平均負けトレード:</strong> {{ $json.avgLoss }}</li>\n  <li><strong>プロフィットファクター:</strong> {{ $json.profitFactor }}</li>\n  <li><strong>リスクリワードレシオ:</strong> {{ $json.riskRewardRatio }}</li>\n  <li><strong>最大連勝:</strong> {{ $json.maxWinStreak }}</li>\n  <li><strong>最大連敗:</strong> {{ $json.maxLossStreak }}</li>\n</ul>\n\n<h3>本日の成績</h3>\n<ul>\n  <li><strong>本日のトレード数:</strong> {{ $json.todayTrades }}</li>\n  <li><strong>本日の損益:</strong> {{ $json.todayProfit }}</li>\n</ul>\n\n<hr>\n<p><small>このレポートは自動生成されました - {{ $json.reportDate }}</small></p>",
        "options": {}
