    {
      "parameters": {
        "jsCode": "// トレード統計を計算\nconst trades = $input.all();\n\nlet totalTrades = trades.length - 1; // ヘッダー行を除く\nlet wins = 0;\nlet losses = 0;\nlet totalProfit = 0;\nlet totalLoss = 0;\nlet winningProfits = [];\nlet losingLosses = [];\n\nfor (let i = 1; i < trades.length; i++) {\n  const trade = trades[i].json;\n  const profit = parseFloat(trade['損益額']) || 0;\n  \n  totalProfit += profit;\n  \n  if (profit >= 0) {\n    wins++;\n    winningProfits.push(profit);\n  } else {\n    losses++;\n    losingLosses.push(Math.abs(profit));\n  }\n}\n\n// 統計計算\nconst winRate = totalTrades > 0 ? (wins / totalTrades * 100).toFixed(2) : 0;\nconst avgWin = winningProfits.length > 0 ? (winningProfits.reduce((a, b) => a + b, 0) / winningProfits.length).toFixed(2) : 0;\nconst avgLoss = losingLosses.length > 0 ? (losingLosses.reduce((a, b) => a + b, 0) / losingLosses.length).toFixed(2) : 0;\nconst profitFactor = totalLoss !== 0 ? (winningProfits.reduce((a, b) => a + b, 0) / losingLosses.reduce((a, b) => a + b, 0)).toFixed(2) : 0;\nconst riskRewardRatio = avgLoss !== 0 ? (avgWin / avgLoss).toFixed(2) : 0;\n\n// 最大連勝・連敗\nlet maxWinStreak = 0;\nlet maxLossStreak = 0;\nlet currentWinStreak = 0;\nlet currentLossStreak = 0;\n\nfor (let i = 1; i < trades.length; i++) {\n  const profit = parseFloat(trades[i].json['損益額']) || 0;\n  \n  if (profit >= 0) {\n    currentWinStreak++;\n    currentLossStreak = 0;\n    maxWinStreak = Math.max(maxWinStreak, currentWinStreak);\n  } else {\n    currentLossStreak++;\n    currentWinStreak = 0;\n    maxLossStreak = Math.max(maxLossStreak, currentLossStreak);\n  }\n}\n\n// 今日のトレード統計\nconst today = new Date().toISOString().split('T')[0];\nconst todayTrades = trades.filter(t => {\n  const tradeDate = t.json['日時'] ? t.json['日時'].split('T')[0] : '';\n  return tradeDate === today;\n});\n\nconst todayProfit = todayTrades.reduce((sum, t) => {\n  return sum + (parseFloat(t.json['損益額']) || 0);\n}, 0);\n\nreturn [{\n  json: {\n    totalTrades: totalTrades,\n    wins: wins,\n    losses: losses,\n    winRate: winRate,\n    totalProfit: totalProfit.toFixed(2),\n    avgWin: avgWin,\n    avgLoss: avgLoss,\n    profitFactor: profitFactor,\n    riskRewardRatio: riskRewardRatio,\n    maxWinStreak: maxWinStreak,\n    maxLossStreak: maxLossStreak,\n    todayTrades: todayTrades.length,\n    todayProfit: todayProfit.toFixed(2),\n    reportDate: new Date().toISOString()\n  }\n}];"
      },
      "id": "calculate-statistics",
